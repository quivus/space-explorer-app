{
  "expo": {
    "name": "Space Explorer",
    "slug": "space_explorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/SpaceExplorer.png",
    "scheme": "spaceexplorer",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/SpaceExplorer.png",
        "monochromeImage": "./assets/images/SpaceExplorer.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/SpaceExplorer.png",
          "imageWidth": 180
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
